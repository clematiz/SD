# 1. CLOCK E RESET
NET "clk" LOC = "E12" | IOSTANDARD = LVCMOS33 ;
NET "clk" PERIOD = 20.0ns HIGH 40%;
NET "rst_btn" LOC = "T15" | IOSTANDARD = LVCMOS33 | PULLDOWN ; # BTN_SOUTH

# 2. TECLADO PS/2 (CONECTOR J28 - PULLUP OBRIGATÓRIO)
NET "ps2_clk_in"  LOC = "W12" | IOSTANDARD = LVCMOS33 | PULLUP ;
NET "ps2_data_in" LOC = "V11" | IOSTANDARD = LVCMOS33 | PULLUP ;

# 3. DISPLAY LCD DE CARACTERES
NET "lcd_e"       LOC = "AB4"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;
NET "lcd_rs"      LOC = "Y14"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;
NET "lcd_rw"      LOC = "W13"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;
NET "lcd_data<3>" LOC = "Y15"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ; # DB7
NET "lcd_data<2>" LOC = "AB16" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ; # DB6
NET "lcd_data<1>" LOC = "Y16"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ; # DB5
NET "lcd_data<0>" LOC = "AA12" | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ; # DB4

# 4. DESABILITAÇÃO DA MEMÓRIA FLASH PARALELA
NET "sf_ce0"      LOC = "W20"  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = SLOW ;